# Quadlet container file for sb_db_server
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _sb_db_volumes = [] -%}
{%- set _sb_db_volumes = _sb_db_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_common_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_tls_cacert_volumes -%}
{%- if edpm_ovn_bgp_agent_internal_tls_enable | bool -%}
{%- set _sb_db_volumes = _sb_db_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_tls_volumes -%}
{%- endif %}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=OVN SB DB Server container (EDPM OVN BGP Agent)
After=openvswitch.service
Requires=openvswitch.service

[Container]
ContainerName=sb_db_server
Image={{ edpm_ovn_bgp_agent_local_ovn_sb_db_image }}
Network=host
User=root
PodmanArgs=--privileged --log-driver=journald
{% if edpm_ovn_cpu_set | default(false) -%}
PodmanArgs=--cpuset-cpus={{ edpm_ovn_cpu_set }}
{% endif -%}
{%- if edpm_ovn_bgp_agent_internal_tls_enable | bool -%}
Exec=/usr/share/ovn/scripts/ovn-ctl --no-monitor run_sb_ovsdb --ovn-sb-db-ssl-key=/etc/pki/tls/private/ovndb.key --ovn-sb-db-ssl-cert=/etc/pki/tls/certs/ovndb.crt --ovn-sb-db-ssl-ca-cert=/etc/pki/tls/certs/ovndbca.crt --db-sb-cluster-local-proto=ssl --db-sb-cluster-remote-proto=ssl --db-sb-create-insecure-remote=no
{%- else -%}
Exec=/usr/share/ovn/scripts/ovn-ctl --no-monitor run_sb_ovsdb --db-sb-create-insecure-remote=yes
{%- endif %}
{% for vol in _sb_db_volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
