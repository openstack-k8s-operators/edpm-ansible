# Quadlet container file for northd
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _northd_volumes = [] -%}
{%- set _northd_volumes = _northd_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_common_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_tls_cacert_volumes -%}
{%- if edpm_ovn_bgp_agent_internal_tls_enable | bool -%}
{%- set _northd_volumes = _northd_volumes
    + edpm_ovn_bgp_agent_local_ovn_cluster_tls_volumes -%}
{%- endif %}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=OVN Northd container (EDPM OVN BGP Agent)
After=openvswitch.service edpm_nb_db_server.service edpm_sb_db_server.service
Requires=openvswitch.service

[Container]
ContainerName=northd
Image={{ edpm_ovn_bgp_agent_local_ovn_northd_image }}
Network=host
User=root
PodmanArgs=--privileged --log-driver=journald
{% if edpm_ovn_cpu_set | default(false) -%}
PodmanArgs=--cpuset-cpus={{ edpm_ovn_cpu_set }}
{% endif -%}
{%- if edpm_ovn_bgp_agent_internal_tls_enable | bool -%}
Exec=/usr/bin/ovn-northd --ovnnb-db=unix:/var/run/ovn/ovnnb_db.sock --ovnsb-db=unix:/var/run/ovn/ovnsb_db.sock -p /etc/pki/tls/private/ovndb.key -c /etc/pki/tls/certs/ovndb.crt -C /etc/pki/tls/certs/ovndbca.crt
{%- else -%}
Exec=/usr/bin/ovn-northd --ovnnb-db=unix:/var/run/ovn/ovnnb_db.sock --ovnsb-db=unix:/var/run/ovn/ovnsb_db.sock
{%- endif %}
{% for vol in _northd_volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
