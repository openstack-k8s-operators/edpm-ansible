{%- set edpm_neutron_metadata_volumes = [] %}
{%- set edpm_neutron_metadata_volumes =
        edpm_neutron_metadata_volumes +
        edpm_neutron_metadata_common_volumes +
        edpm_neutron_metadata_tls_cacert_volumes %}
{%- if edpm_neutron_metadata_agent_tls_enabled | bool %}
{%- set edpm_neutron_metadata_volumes =
        edpm_neutron_metadata_volumes +
        edpm_neutron_metadata_tls_volumes %}
{%- endif -%}
{%- if edpm_neutron_metadata_unbound_conf_content | length > 0 %}
{%- set edpm_neutron_metadata_volumes =
        edpm_neutron_metadata_volumes +
        [edpm_neutron_metadata_unbound_conf_src ~ ':' ~ edpm_neutron_metadata_unbound_conf_dest ~ ':ro,z'] %}
{%- endif -%}
image: "{{ edpm_neutron_metadata_agent_image }}"
net: host
pid: host
cgroupns: host
privileged: true
user: root
restart: always
depends_on:
  - openvswitch.service
{% if edpm_neutron_metadata_healthcheck %}
healthcheck:
        test: /openstack/healthcheck
        mount: /var/lib/openstack/healthchecks/ovn_metadata_agent
{% endif %}
volumes: {{ edpm_neutron_metadata_volumes }}
environment:
  KOLLA_CONFIG_STRATEGY: COPY_ALWAYS
{% if edpm_neutron_metadata_unbound_conf_content | length > 0 %}
  OVS_UNBOUND_CONF: "{{ edpm_neutron_metadata_unbound_conf_dest }}"
  EDPM_OVN_UNBOUND_CONF_CHECKSUM: "{{ edpm_neutron_metadata_unbound_conf_content | hash('sha256') }}"
{% endif %}
