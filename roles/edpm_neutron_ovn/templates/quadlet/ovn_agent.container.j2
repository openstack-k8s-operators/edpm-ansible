# Quadlet container file for ovn_agent
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _ovn_agent_volumes = [] -%}
{%- set _ovn_agent_volumes = _ovn_agent_volumes
    + edpm_neutron_ovn_common_volumes
    + edpm_neutron_ovn_tls_cacert_volumes -%}
{%- if edpm_neutron_ovn_evpn_extension_enabled | bool -%}
{%- set _ovn_agent_volumes = _ovn_agent_volumes
    + edpm_neutron_ovn_frr_volumes -%}
{%- endif -%}
{%- if edpm_neutron_ovn_tls_enabled | bool -%}
{%- set _ovn_agent_volumes = _ovn_agent_volumes
    + edpm_neutron_ovn_tls_volumes -%}
{%- endif %}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=
# Unbound configuration checksum: {{ edpm_neutron_ovn_unbound_conf_content | hash('sha256') }}

[Unit]
Description=Neutron OVN Agent container (EDPM)
After=openvswitch.service edpm_ovn_agent_init.service
Wants=openvswitch.service
Requires=edpm_ovn_agent_init.service

[Container]
ContainerName=ovn_agent
Image={{ edpm_neutron_ovn_agent_image }}
Network=host
User=root
PodmanArgs=--privileged --log-driver=journald
PodmanArgs=--pid=host
PodmanArgs=--cgroupns=host
Exec=/usr/bin/neutron-ovn-agent
{% for vol in _ovn_agent_volumes -%}
Volume={{ vol }}
{% endfor -%}
{% if edpm_neutron_ovn_unbound_conf_content | length > 0 -%}
Volume={{ edpm_neutron_ovn_unbound_conf_src }}:{{ edpm_neutron_ovn_unbound_conf_dest }}:ro,z
Environment=OVS_UNBOUND_CONF={{ edpm_neutron_ovn_unbound_conf_dest }}
{% endif -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
