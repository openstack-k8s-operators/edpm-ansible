# Quadlet container file for neutron_sriov_agent
# Managed by edpm_container_standalone - do not edit manually
# Podman 5+ quadlet keys (RHEL 9.5+)
{%- set _sriov_volumes = [] -%}
{%- set _sriov_volumes = _sriov_volumes
    + edpm_neutron_sriov_common_volumes
    + edpm_neutron_sriov_tls_cacert_volumes %}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Neutron SR-IOV Agent container (EDPM)
After=edpm_neutron_sriov_agent_init.service
Requires=edpm_neutron_sriov_agent_init.service

[Container]
ContainerName=neutron_sriov_agent
Image={{ edpm_neutron_sriov_image }}
Network=host
User=neutron
PodmanArgs=--privileged
LogDriver=journald
Exec=/usr/bin/neutron-sriov-nic-agent
{% for vol in _sriov_volumes -%}
Volume={{ vol }}
{% endfor -%}
{% if edpm_neutron_sriov_healthcheck -%}
Volume=/var/lib/openstack/healthchecks/neutron_sriov:/openstack:ro,z
HealthCmd=/openstack/healthcheck
HealthInterval=60s
HealthTimeout=25s
HealthRetries=3
HealthStartPeriod=180s
{% endif -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
