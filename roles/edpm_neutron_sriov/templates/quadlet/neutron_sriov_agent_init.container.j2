# Quadlet container file for neutron_sriov_agent_init
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Neutron SR-IOV Agent init container (EDPM)

[Container]
ContainerName=neutron_sriov_agent_init
Image={{ edpm_neutron_sriov_image }}
Network=none
User=root
PodmanArgs=--security-opt label=disable --log-driver=journald
Exec=/usr/bin/chown -R neutron:neutron /var/lib/neutron
Volume=/var/lib/neutron:/var/lib/neutron:shared,z
Label=managed_by=edpm_ansible

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=no
TimeoutStartSec=900
TimeoutStopSec=84
