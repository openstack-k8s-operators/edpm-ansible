if pgrep --ns "$$" --nslist mnt -r R,S,D -f \
    '(^|[[:space:]/])neutron-sriov-nic-agent([[:space:]]|$)' >/dev/null; then
    exit 0
fi

echo "ERROR: neutron_sriov healthcheck: neutron-sriov-nic-agent is not running in this container" >&2
exit 1
