image: "{{ edpm_neutron_sriov_image }}"
net: host
privileged: true
user: neutron
restart: always
{% if edpm_neutron_sriov_healthcheck %}
healthcheck:
  test: /openstack/healthcheck
  mount: /var/lib/openstack/healthchecks/neutron_sriov
{% endif %}
volumes:
  {% set edpm_neutron_sriov_volumes = [] %}
  {%- set edpm_neutron_sriov_volumes =
          edpm_neutron_sriov_volumes +
          edpm_neutron_sriov_common_volumes +
          edpm_neutron_sriov_tls_cacert_volumes %}
  {{ edpm_neutron_sriov_volumes }}
environment:
  KOLLA_CONFIG_STRATEGY: COPY_ALWAYS
