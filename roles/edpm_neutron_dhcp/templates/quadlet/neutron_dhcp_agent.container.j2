# Quadlet container file for neutron_dhcp_agent
# Managed by edpm_container_standalone - do not edit manually
# Podman 5+ quadlet keys (RHEL 9.5+)
{%- set _dhcp_volumes = [] -%}
{%- set _dhcp_volumes = _dhcp_volumes
    + edpm_neutron_dhcp_common_volumes
    + edpm_neutron_dhcp_tls_cacert_volumes %}


# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Neutron DHCP Agent container (EDPM)
After=edpm_neutron_dhcp_init.service
Requires=edpm_neutron_dhcp_init.service

[Container]
ContainerName=neutron_dhcp_agent
Image={{ edpm_neutron_dhcp_image }}
Network=host
User=root
PodmanArgs=--privileged
LogDriver=journald
PodmanArgs=--pid=host
PodmanArgs=--cgroupns=host
Exec=/usr/bin/neutron-dhcp-agent
{% for vol in _dhcp_volumes -%}
Volume={{ vol }}
{% endfor -%}
{% if edpm_neutron_dhcp_healthcheck -%}
Volume=/var/lib/openstack/healthchecks/neutron_dhcp:/openstack:ro,z
HealthCmd=/openstack/healthcheck
HealthInterval=60s
HealthTimeout=25s
HealthRetries=3
HealthStartPeriod=180s
{% endif -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
