# Quadlet container file for rsync
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _volumes = edpm_swift_rsync_volumes +
        edpm_swift_storage_volumes +
        edpm_swift_ring_volumes -%}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Swift rsync container (EDPM)

[Container]
ContainerName=rsync
Image={{ edpm_swift_object_image }}
Network=host
User=swift
PodmanArgs=--privileged --pid=host --cgroupns=host --log-driver=journald
AddCapability=NET_BIND_SERVICE
Exec=/usr/bin/rsync --daemon --no-detach --config=/etc/swift/rsyncd.conf
{% for vol in _volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
