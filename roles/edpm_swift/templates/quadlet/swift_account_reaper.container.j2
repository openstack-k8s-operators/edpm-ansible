# Quadlet container file for swift_account_reaper
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _volumes = edpm_swift_account_reaper_volumes +
        edpm_swift_storage_volumes -%}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Swift account reaper container (EDPM)

[Container]
ContainerName=swift_account_reaper
Image={{ edpm_swift_account_image }}
Network=host
User=swift
PodmanArgs=--privileged --pid=host --cgroupns=host --log-driver=journald
Environment=KOLLA_CONFIG_STRATEGY=COPY_ALWAYS
{% for vol in _volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
