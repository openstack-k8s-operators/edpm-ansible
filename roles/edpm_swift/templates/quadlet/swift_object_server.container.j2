# Quadlet container file for swift_object_server
# Managed by edpm_container_standalone - do not edit manually
# Podman 5+ quadlet keys (RHEL 9.5+)
{%- set _volumes = edpm_swift_object_conf_volumes +
        edpm_swift_storage_volumes +
        edpm_swift_ring_volumes -%}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Swift object server container (EDPM)

[Container]
ContainerName=swift_object_server
Image={{ edpm_swift_object_image }}
Network=host
User=swift
PodmanArgs=--privileged
PodmanArgs=--pid=host
PodmanArgs=--cgroupns=host
LogDriver=journald
Exec=/usr/bin/swift-object-server /etc/swift/object-server.conf.d/
{% for vol in _volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
