# Quadlet container file for swift_container_server
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)
{%- set _volumes = edpm_swift_container_conf_volumes +
        edpm_swift_storage_volumes +
        edpm_swift_ring_volumes -%}

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Swift container server container (EDPM)

[Container]
ContainerName=swift_container_server
Image={{ edpm_swift_container_image }}
Network=host
User=swift
PodmanArgs=--privileged --pid=host --cgroupns=host --log-driver=journald
Exec=/usr/bin/swift-container-server /etc/swift/container-server.conf.d/
{% for vol in _volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
