# Quadlet container file for cyborg_agent_init
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=Cyborg Agent init container (EDPM)

[Container]
ContainerName=cyborg_agent_init
Image={{ edpm_cyborg_agent_image }}
Network=none
User=root
PodmanArgs=--security-opt label=disable --log-driver=journald
Exec=/usr/bin/chown -R cyborg:cyborg /var/lib/cyborg
Volume=/var/lib/cyborg:/var/lib/cyborg:shared
Label=managed_by=edpm_ansible

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=no
TimeoutStartSec=900
TimeoutStopSec=84
