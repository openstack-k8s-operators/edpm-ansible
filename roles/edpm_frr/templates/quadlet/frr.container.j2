# Quadlet container file for frr
# Managed by edpm_container_standalone - do not edit manually
# Podman 4.4+ keys only (RHEL 9.2 compat)

# DO NOT REMOVE - used by container_config_hash module
# config_hash=

[Unit]
Description=FRR container (EDPM)
After=edpm_frr_init.service
Requires=edpm_frr_init.service

[Container]
ContainerName=frr
Image={{ edpm_frr_image }}
Network=host
User=frr
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_NET_RAW
AddCapability=CAP_NET_ADMIN
AddCapability=CAP_SYS_ADMIN
PodmanArgs=--log-driver=journald
Exec=bash -c 'if [ -f /usr/libexec/frr/frrinit.sh ]; then /usr/libexec/frr/frrinit.sh start; else /usr/lib/frr/frr start; fi && exec /bin/sleep infinity'
{% for vol in edpm_frr_volumes -%}
Volume={{ vol }}
{% endfor -%}
Label=managed_by=edpm_ansible

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=84

[Install]
WantedBy=multi-user.target
